# --- NVIDIA NIM (LLM + embeddings) ---
# Get a key at https://build.nvidia.com (starts with "nvapi-"). Never commit real values.
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# Verify the exact model id against build.nvidia.com's catalog before first run — it changes.
NVIDIA_LLM_MODEL=
NVIDIA_EMBED_MODEL=
# Must match the embed model's output dimension. Change here AND in the migration's
# `vector(N)` column before the first ingest — pgvector column dimension is fixed at creation.
NVIDIA_EMBED_DIMENSIONS=1024

# --- LLM provider selection ---
# Which provider the Consent Agent's reasoning/structured-output step uses.
# Embeddings (RAG) always use NVIDIA regardless of this setting -- Groq has no
# embeddings endpoint. "nvidia" (default) keeps existing behavior unchanged.
LLM_PROVIDER=nvidia
# --- Groq (optional second reasoning provider) ---
# Get a key at https://console.groq.com (starts with "gsk_"). Only required if
# LLM_PROVIDER=groq. Verify the exact model id against GET /v1/models -- it changes.
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=

# --- Self-hosted primary LLM (optional) ---
# Any OpenAI-compatible server (e.g. llama.cpp's `server` binary). Tried FIRST when
# both vars below are set; LLM_PROVIDER above becomes the fallback if it fails. Leave
# both unset to keep using LLM_PROVIDER exclusively (existing behavior, unchanged).
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_MODEL=
LLM_PRIMARY_API_KEY=

# --- Postgres ---
# Connection (asyncpg) for SQLAlchemy, migrations and the LangGraph checkpointer.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/consiva

# --- First-party auth (app/core/tokens.py) ---
# Signs and verifies Consiva-issued access tokens, and seeds the
# domain-verification HMAC. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it invalidates every issued token (everyone re-logs in) -- which is
# also how you force a global logout.
CONSIVA_JWT_SECRET=

# --- Supabase auth (LEGACY, optional) ---
# Identity now lives in this database (migrations/0010_local_auth.sql). These are
# kept only so a deployment mid-transition keeps accepting already-issued
# Supabase tokens; delete them once every user has a local account.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Connections each process may hold. Supabase's session-mode pooler (port 5432) caps
# the whole project at 15 clients, so these stay small: 3+2=5 per process keeps three
# concurrent processes (api + worker + a dev machine) inside that ceiling. Exhausting
# it makes scans fail at the website_scan stage on every machine at once.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# --- Scanner ---
SCANNER_HEADLESS=true
SCANNER_MAX_PAGES=25
SCANNER_TIMEOUT_SECONDS=30
SCANNER_USER_AGENT=ConsivaConsentAgent/0.1 (+https://consiva.example/bot)
SCANNER_MAX_SCANS_PER_ORG_PER_DAY=50

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Action Module notifications (optional) ---
# Point at a real Slack/Discord/MS Teams "incoming webhook" URL, or any endpoint that
# accepts POST JSON. Unset by default: a notification Action can never be marked
# "done" without a real HTTP POST here actually succeeding -- no endpoint configured
# means it correctly stays "open" rather than lying about being sent.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=10

# --- Agent 2: Data Discovery / ROPA ---
# CLI defaults for `python -m app.agents.ropa.run_single_discovery <url>`. Only
# needed for local/manual discovery runs; configured sources in the
# ropa_data_sources table reference their secret by NAME instead (see below).
ROPA_ORG_ID=
ROPA_SOURCE_HOST=
ROPA_SOURCE_PORT=5432
ROPA_SOURCE_DBNAME=
ROPA_SOURCE_USER=
ROPA_SOURCE_PASSWORD=
ROPA_SOURCE_SSLMODE=require

# --- ROPA external source credentials (secret-reference pattern) ---
# A configured data source stores only `credential_ref`: the NAME of the
# environment entry holding its secret -- never the secret itself. So a database
# dump contains no usable credential, and rotating one means changing the value
# here with no DB write.
#
# Add one variable per configured source, named to match its credential_ref.
# Example, for a source created with credential_ref="PREPMYEVENT_DB_PASSWORD":
# PREPMYEVENT_DB_PASSWORD=

# --- ROPA integration adapter (set on the CUSTOMER's server, not here) ---
# These belong in the environment of the machine running the adapter (e.g.
# PrepMyEvent's VM), NOT in Consiva's own .env. Listed for reference only:
# CONSIVA_INTEGRATION_KEY=csv_<prefix>_<secret>   # from POST /api/v1/ropa/integration-keys
# CONSIVA_BASE_URL=https://api.consiva.ai
