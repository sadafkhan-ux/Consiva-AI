# --- NVIDIA NIM (LLM + embeddings) ---
# Get a key at https://build.nvidia.com (starts with "nvapi-"). Never commit real values.
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# Verify the exact model id against build.nvidia.com's catalog before first run — it changes.
NVIDIA_LLM_MODEL=
NVIDIA_EMBED_MODEL=
# Must match the embed model's output dimension. Change here AND in the migration's
# `vector(N)` column before the first ingest — pgvector column dimension is fixed at creation.
NVIDIA_EMBED_DIMENSIONS=1024
# Maximum cosine distance a retrieved chunk may have and still be used as grounding
# for a finding; chunks past this are dropped rather than padding the context with
# irrelevant text. Lower = stricter relevance match.
RAG_MAX_DISTANCE=0.95

# --- LLM provider selection ---
# Which provider the Consent Agent's reasoning/structured-output step uses.
# Embeddings (RAG) always use NVIDIA regardless of this setting -- Groq has no
# embeddings endpoint. "nvidia" (default) keeps existing behavior unchanged.
LLM_PROVIDER=nvidia
# --- Groq (optional second reasoning provider) ---
# Get a key at https://console.groq.com (starts with "gsk_"). Only required if
# LLM_PROVIDER=groq. Verify the exact model id against GET /v1/models -- it changes.
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=

# --- Self-hosted primary LLM (optional) ---
# Any OpenAI-compatible server (e.g. llama.cpp's `server` binary). Tried FIRST when
# both vars below are set; LLM_PROVIDER above becomes the fallback if it fails. Leave
# both unset to keep using LLM_PROVIDER exclusively (existing behavior, unchanged).
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_MODEL=
LLM_PRIMARY_API_KEY=
# Shared wall-clock budget (seconds) across the primary attempt AND its fallback
# combined -- not per-attempt -- so a slow self-hosted primary can't push a request
# past what the caller is actually willing to wait.
LLM_DEADLINE_SECONDS=480

# --- Postgres ---
# Connection (asyncpg) for SQLAlchemy, migrations and the LangGraph checkpointer.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/consiva

# Optional. Set BOTH of these to activate database-level tenant isolation
# (migration 0018): point DATABASE_URL at the least-privilege `consiva_app` role so
# row-level security applies to the API, and WORKER_DATABASE_URL at the privileged
# role so the worker's cross-tenant SLA sweeps keep working. Leave WORKER_DATABASE_URL
# unset and the worker just uses DATABASE_URL, which is correct while the API is still
# on the privileged role.
#
#   psql -c "alter role consiva_app login password 'generate-one'"
#   DATABASE_URL=postgresql+asyncpg://consiva_app:<pw>@localhost:5432/consiva
#   WORKER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/consiva
# WORKER_DATABASE_URL=

# --- First-party auth (app/core/tokens.py) ---
# Signs and verifies Consiva-issued access tokens, and seeds the
# domain-verification HMAC. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it invalidates every issued token (everyone re-logs in) -- which is
# also how you force a global logout.
CONSIVA_JWT_SECRET=

# --- ROPA data-source credential encryption (optional) ---
# Lets an operator self-service a new source's credential via
# POST /ropa/sources/{id}/credential instead of adding an env var and
# restarting. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave unset to keep every ROPA source on the env-var `credential_ref` path --
# nothing else about ROPA changes if you don't set this.
ROPA_CREDENTIAL_ENCRYPTION_KEY=

# --- Supabase auth (LEGACY, optional) ---
# Identity now lives in this database (migrations/0010_local_auth.sql). These are
# kept only so a deployment mid-transition keeps accepting already-issued
# Supabase tokens; delete them once every user has a local account.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Connections each process may hold. Supabase's session-mode pooler (port 5432) caps
# the whole project at 15 clients, so these stay small: 3+2=5 per process keeps three
# concurrent processes (api + worker + a dev machine) inside that ceiling. Exhausting
# it makes scans fail at the website_scan stage on every machine at once.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
# How many queued jobs app/jobs/worker.py processes concurrently (scan/analyze,
# ropa_discovery, DSR, breach, regwatch).
WORKER_CONCURRENCY=4

# --- Scanner ---
SCANNER_HEADLESS=true
SCANNER_MAX_PAGES=25
SCANNER_TIMEOUT_SECONDS=30
SCANNER_USER_AGENT=ConsivaConsentAgent/0.1 (+https://consiva.example/bot)
SCANNER_MAX_SCANS_PER_ORG_PER_DAY=50
# Scans a single site can run at once (per-scan concurrency, not across scans).
SCANNER_MAX_CONCURRENT_PAGES=4
SCANNER_LOCALE=en-IN
SCANNER_ACCEPT_LANGUAGE=en-IN,en;q=0.9
# Require a scan target to have completed domain ownership verification before
# scanning. Off by default for local/dev use.
SCANNER_REQUIRE_DOMAIN_VERIFICATION=false
# Per-organization rate limit on the external /consent-agent API's scan-trigger route.
CONSENT_API_SCANS_PER_HOUR=20

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# When true, POST /api/v1/dev/auto-login signs every visitor in as the oldest user in
# the database, no password, in ANY environment -- anyone who can reach the URL gets
# that user's full access. Leave false on any deployment holding data that must not be
# public.
OPEN_ACCESS=false
# Browser origins allowed to call this API, comma-separated, exact scheme+host (no
# wildcards -- the API is credentialed). Honoured in every APP_ENV, including
# development, where localhost on any port is also allowed.
# Under docker-compose.prod.yml, set this in /opt/consiva/.env, NOT backend/.env:
# compose passes it through `environment:`, which overrides env_file, so a value
# here is silently replaced (empty if the root file lacks it -- every origin blocked).
CORS_ALLOWED_ORIGINS=https://consiva.ai,https://consiva-agent.gignati.com,https://uat.consiva.ai

# --- Action Module notifications (optional) ---
# Point at a real Slack/Discord/MS Teams "incoming webhook" URL, or any endpoint that
# accepts POST JSON. Unset by default: a notification Action can never be marked
# "done" without a real HTTP POST here actually succeeding -- no endpoint configured
# means it correctly stays "open" rather than lying about being sent.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=10

# --- Outbound webhook delivery signing (app/services/webhook_service.py) ---
# HMAC key used to sign outbound webhook deliveries (scan-completed events, etc.) so
# the receiver can verify authenticity. Unset means delivery refuses to send rather
# than deliver unsigned. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBHOOK_SIGNING_SECRET=

# --- Agent 2: Data Discovery / ROPA ---
# CLI defaults for `python -m app.agents.ropa.run_single_discovery <url>`. Only
# needed for local/manual discovery runs; configured sources in the
# ropa_data_sources table reference their secret by NAME instead (see below).
ROPA_ORG_ID=
ROPA_SOURCE_HOST=
ROPA_SOURCE_PORT=5432
ROPA_SOURCE_DBNAME=
ROPA_SOURCE_USER=
ROPA_SOURCE_PASSWORD=
ROPA_SOURCE_SSLMODE=require

# --- Agent-event webhook (external partner notification channel) ---
# Fires when a ROPA run or a Consent Agent API scan reaches completed/failed.
# Distinct from WEBHOOK_SIGNING_SECRET above, which signs a CALLER-supplied
# per-scan webhook_url with Consiva's own scheme instead. This one uses the
# partner's own signing scheme (X-Agent-Timestamp/X-Agent-Signature:
# sha256=<hex over "<timestamp>.<raw body>">).
#
# The real per-environment destinations (the partner's own backend API, which
# their website/app already call -- NOT a Consiva frontend host):
#   UAT:        https://uatapi.consiva.ai/api/v1/webhooks/agents
#   production: https://api.consiva.ai/api/v1/webhooks/agents
# Each environment has its own AgentWebhook:Secret set on their own API --
# fill AGENT_WEBHOOK_SECRET with the value for THIS deployment's environment
# only, never share one secret across environments.
#
# IMPORTANT if one Consiva agent instance (e.g. consiva-agent.gignati.com)
# answers for BOTH UAT and production -- true of this deployment today
# (CORS_ALLOWED_ORIGINS above already spans both) -- these two fixed values
# are NOT enough by themselves: a UAT-started run must call the UAT URL
# signed with the UAT secret, never production's. For that case, the caller
# that creates the run/scan (POST /sources/{id}/discover, POST /evidence,
# POST /consent-agent/scans) passes its OWN callback_url/callback_secret per
# request, which agent_webhook_service.send_event prefers over these fixed
# values for that one delivery -- see its module docstring. Leave both unset
# to disable the fixed destination entirely (per-request overrides still
# work; nothing is sent for a run/scan that supplies neither).
AGENT_WEBHOOK_URL=
AGENT_WEBHOOK_SECRET=

# --- ROPA external source credentials (secret-reference pattern) ---
# A configured data source stores only `credential_ref`: the NAME of the
# environment entry holding its secret -- never the secret itself. So a database
# dump contains no usable credential, and rotating one means changing the value
# here with no DB write.
#
# Add one variable per configured source, named to match its credential_ref.
# Example, for a source created with credential_ref="PREPMYEVENT_DB_PASSWORD":
# PREPMYEVENT_DB_PASSWORD=

# --- ROPA integration adapter (set on the CUSTOMER's server, not here) ---
# These belong in the environment of the machine running the adapter (e.g.
# PrepMyEvent's VM), NOT in Consiva's own .env. Listed for reference only:
# CONSIVA_INTEGRATION_KEY=csv_<prefix>_<secret>   # from POST /api/v1/ropa/integration-keys
# CONSIVA_BASE_URL=https://api.consiva.ai
