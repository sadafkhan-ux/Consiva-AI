# Consiva ROPA integration adapter — environment for the PrepMyEvent server.
#
# Copy to .env (or set these in your systemd unit / secret manager).
# NEVER commit the filled-in file. NEVER paste a real key into a ticket or chat.

# Integration key issued by Consiva. Format: csv_<prefix>_<secret>
# Obtained once from Consiva; the full value is shown only at creation time.
# Rotate by asking Consiva for a new key, updating this value, and having the
# old key revoked.
CONSIVA_INTEGRATION_KEY=csv_REPLACE_ME_prefix_REPLACE_ME_secret

# Consiva ingestion endpoint. Must be https:// -- the adapter refuses plain http.
# REQUIRED, and deployment-specific: use the exact host Consiva gave you. There is
# no default, because a wrong one would 404 on your first push.
CONSIVA_BASE_URL=

# Optional. Only needed if the adapter cannot import your existing
# `backend.database` module. Leave BLANK to reuse your app's own engine, which
# is the recommended path — then no database credential is duplicated at all.
#
# If you do set it, point it at a READ-ONLY role (see README, "Database
# permissions"). The adapter only reads the system catalog.
DATABASE_URL=
