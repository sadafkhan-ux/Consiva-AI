# Consiva -- settings READ BY DOCKER COMPOSE (docker-compose.prod.yml).
#
# Copy to `.env` NEXT TO docker-compose.prod.yml (on the server: /opt/consiva/.env) and fill in the
# blanks. Compose reads this file to fill in ${...} values in the compose file.
#
# This is NOT backend/.env. That is a different file, with the application's own secrets (API keys,
# model endpoints, ...); see backend/.env.example. The two are read by different things -- a value
# put in the wrong one is silently invisible, so each is listed where it is actually consumed.
#
# Never commit the real `.env`, and never paste real values into this example.

# ── Required: compose refuses to start the stack without these ──────────────────────────────────
# Password for the bundled Postgres. Used by `db` and, via the one shared DATABASE_URL, by
# `migrate`, `backend` and `worker`. Choose a long random value.
POSTGRES_PASSWORD=
# Must be exactly `production` on a server. (The development value mints login tokens for anyone.)
APP_ENV=production
# Signs and verifies login tokens. Choose a long random value (at least 32 characters).
CONSIVA_JWT_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────────────────────────
# Host port (or ip:port) the frontend is published on. Default 8080.
FRONTEND_PORT=8080
# Browser origins allowed to call the API, comma-separated. Never "*".
CORS_ALLOWED_ORIGINS=
# Signs outbound scan-completion webhooks. Unset = webhook requests are refused with 501.
WEBHOOK_SIGNING_SECRET=
# Scans per organisation per hour through the integration API.
CONSENT_API_SCANS_PER_HOUR=20
# Concurrent jobs per worker, and its database pool (raise together).
WORKER_CONCURRENCY=4
WORKER_DB_POOL_SIZE=10
WORKER_DB_MAX_OVERFLOW=5
# true = no login screen (every visitor signed in as the oldest user). Leave false on a server.
OPEN_ACCESS=false

# ── Database migrations (run automatically by the one-shot `migrate` service) ────────────────────
# Seconds `migrate` keeps retrying while Postgres is starting. A wrong password or database name
# is NOT retried -- it fails immediately.
MIGRATE_WAIT_FOR_DB_SECONDS=120
# Seconds to wait for another deployment's migration run to finish (they take a database lock).
MIGRATE_LOCK_TIMEOUT_SECONDS=300
# Per-migration Postgres lock_timeout: a migration stuck behind a long-running query fails clearly
# after this many seconds instead of hanging the deployment.
MIGRATE_DDL_LOCK_TIMEOUT_SECONDS=60
